generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String               @id @default(uuid())
  email          String               @unique
  username       String?              @unique
  name           String
  passwordHash   String?              @map("password_hash")
  role           String               @default("user")
  phone          String?
  googleId       String?              @unique @map("google_id")
  emailReminders Boolean              @default(true) @map("email_reminders")
  smsReminders   Boolean              @default(false) @map("sms_reminders")
  activeMoveId   String?              @map("active_move_id")
  locale         String?              @default("en")
  planTier       String               @default("trial") @map("plan_tier")
  trialEndsAt    DateTime?            @map("trial_ends_at")
  planPaidAt     DateTime?            @map("plan_paid_at")
  stripeCustomerId String?            @unique @map("stripe_customer_id")
  suspendedAt    DateTime?            @map("suspended_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  moves          Move[]
  sessions       Session[]
  passwordResets PasswordResetToken[]
  collaborations MoveCollaborator[]   @relation("CollaboratorUser")
  adminAuditLogs AdminAuditLog[]      @relation("AdminAuditActor")
  notificationReads NotificationRead[]
  moveActivities MoveActivity[]
  chatMessages   ChatMessage[]

  @@map("users")
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  admin      User     @relation("AdminAuditActor", fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model SystemAnnouncement {
  id        String    @id @default(uuid())
  message   String    @db.Text
  type      String    @default("info")
  active    Boolean   @default(true)
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([active])
  @@map("system_announcements")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Move {
  id                    String             @id @default(uuid())
  userId                String             @map("user_id")
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  origin                String
  destination           String
  destinationAddress    String?            @map("destination_address")
  destinationLat        Float?             @map("destination_lat")
  destinationLon        Float?             @map("destination_lon")
  originLat             Float?             @map("origin_lat")
  originLon             Float?             @map("origin_lon")
  moveDate              DateTime           @map("move_date") @db.Date
  household             String
  petDetails            String?            @map("pet_details")
  pets                  Boolean            @default(false)
  budget                Int                @default(4000)
  rentalPreference      String             @map("rental_preference")
  needsHousingHelp      Boolean            @default(false) @map("needs_housing_help")
  needsVehicleTransport Boolean            @default(false) @map("needs_vehicle_transport")
  truckChoice           String?            @map("truck_choice")
  vehicleTransportChoice String?           @map("vehicle_transport_choice")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  vehicles              Vehicle[]
  inventoryBoxes        InventoryBox[]
  checklistTasks        ChecklistTask[]
  documents             Document[]
  budgetItems           BudgetItem[]
  collaborators         MoveCollaborator[]
  activities            MoveActivity[]
  partnerQuotes         PartnerQuote[]
  partnerShareToken     String?            @unique @map("partner_share_token")
  partnerShareEnabled   Boolean            @default(false) @map("partner_share_enabled")
  selectedRouteIndex    Int                @default(0) @map("selected_route_index")
  utilityPicks          Json?              @map("utility_picks")
  planShareToken        String?            @unique @map("plan_share_token")
  planShareEnabled      Boolean            @default(false) @map("plan_share_enabled")

  @@index([userId])
  @@map("moves")
}

model PartnerQuote {
  id               String   @id @default(uuid())
  moveId           String   @map("move_id")
  move             Move     @relation(fields: [moveId], references: [id], onDelete: Cascade)
  companyName      String   @map("company_name")
  contactEmail     String   @map("contact_email")
  contactPhone     String?  @map("contact_phone")
  amount           Int?
  amountMin        Int?     @map("amount_min")
  amountMax        Int?     @map("amount_max")
  message          String?  @db.Text
  serviceType      String?  @map("service_type")
  includesPacking  Boolean  @default(false) @map("includes_packing")
  includesInsurance Boolean @default(false) @map("includes_insurance")
  usdotNumber      String?  @map("usdot_number")
  availableDate    String?  @map("available_date")
  status           String   @default("pending")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([moveId])
  @@map("partner_quotes")
}

model MovingPartner {
  id              String   @id @default(uuid())
  name            String
  regions         String[] @default([])
  usdot           String?
  rating          Float?
  yearsInBusiness Int?     @map("years_in_business")
  specialties     String[] @default([])
  website         String?
  contactEmail    String?  @map("contact_email")
  contactPhone    String?  @map("contact_phone")
  notes           String?  @db.Text
  active          Boolean  @default(true)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@map("moving_partners")
}

model MoveCollaborator {
  id          String    @id @default(uuid())
  moveId      String    @map("move_id")
  move        Move      @relation(fields: [moveId], references: [id], onDelete: Cascade)
  userId      String?   @map("user_id")
  user        User?     @relation("CollaboratorUser", fields: [userId], references: [id], onDelete: SetNull)
  email       String
  role        String    @default("editor")
  inviteToken String?   @unique @map("invite_token")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([moveId, email])
  @@index([moveId])
  @@map("move_collaborators")
}

model BudgetItem {
  id             String @id @default(uuid())
  moveId         String @map("move_id")
  move           Move   @relation(fields: [moveId], references: [id], onDelete: Cascade)
  category       String
  estimated      Int
  actual         Int    @default(0)
  cheapestOption String? @map("cheapest_option")
  notes          String?
  sortOrder      Int    @default(0) @map("sort_order")

  @@index([moveId])
  @@map("budget_items")
}

model ReminderLog {
  id     String   @id @default(uuid())
  userId String   @map("user_id")
  taskId String?  @map("task_id")
  channel String
  sentAt DateTime @default(now()) @map("sent_at")

  @@index([userId, taskId, channel])
  @@map("reminder_logs")
}

model Vehicle {
  id           String @id @default(uuid())
  moveId       String @map("move_id")
  move         Move   @relation(fields: [moveId], references: [id], onDelete: Cascade)
  year         String
  makeId       Int?   @map("make_id")
  make         String
  modelId      Int?   @map("model_id")
  model        String
  trim           String?
  displayLabel   String  @map("display_label")
  needsTransport Boolean @default(false) @map("needs_transport")
  combMpg        Float?  @map("comb_mpg")
  cityMpg        Float?  @map("city_mpg")
  highwayMpg     Float?  @map("highway_mpg")
  fuelType       String? @map("fuel_type")

  @@index([moveId])
  @@map("vehicles")
}

model InventoryBox {
  id              String   @id @default(uuid())
  moveId          String   @map("move_id")
  move            Move     @relation(fields: [moveId], references: [id], onDelete: Cascade)
  boxNumber       Int      @map("box_number")
  room            String
  destinationRoom String?  @map("destination_room")
  contents        String
  photoUrl        String?  @map("photo_url") @db.Text
  fragile         Boolean  @default(false)
  essentials      Boolean  @default(false)
  sizeEstimate    String?  @map("size_estimate")
  weightLbs       Float?   @map("weight_lbs")
  assigneeEmail   String?  @map("assignee_email")
  status          String   @default("packed")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([moveId])
  @@map("inventory_boxes")
}

model ChecklistTask {
  id             String    @id @default(uuid())
  moveId         String    @map("move_id")
  move           Move      @relation(fields: [moveId], references: [id], onDelete: Cascade)
  title          String
  category       String
  status         String    @default("pending")
  dueDate        DateTime? @map("due_date") @db.Date
  priority       String    @default("medium")
  notes          String?
  assigneeEmail  String?   @map("assignee_email")

  @@index([moveId])
  @@map("checklist_tasks")
}

model Document {
  id         String    @id @default(uuid())
  moveId     String    @map("move_id")
  move       Move      @relation(fields: [moveId], references: [id], onDelete: Cascade)
  name       String
  category   String
  status     String    @default("pending")
  fileName   String?   @map("file_name")
  storageKey String?   @map("storage_key")
  mimeType   String?   @map("mime_type")
  sizeBytes  Int?      @map("size_bytes")
  uploadedAt DateTime? @map("uploaded_at")
  expiresAt  DateTime? @map("expires_at")

  @@index([moveId])
  @@map("documents")
}

model NotificationRead {
  id     String   @id @default(uuid())
  userId String   @map("user_id")
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  readAt DateTime @default(now()) @map("read_at")

  @@unique([userId, key])
  @@index([userId])
  @@map("notification_reads")
}

model MoveActivity {
  id        String   @id @default(uuid())
  moveId    String   @map("move_id")
  move      Move     @relation(fields: [moveId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([moveId])
  @@index([userId])
  @@map("move_activities")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("chat_messages")
}
