# Copy to .env.local and fill in values. Never commit secrets.

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=postgresql://moveapp:password@localhost:5432/moveapp
WEATHERAPI_KEY=your-weatherapi-key
RENTCAST_API_KEY=your-rentcast-api-key

# Auth & sessions
AUTH_SECRET=generate-a-long-random-string
NEXT_PUBLIC_APP_URL=https://movepilotai.com

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: https://movepilotai.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (https://developer.apple.com/account/resources)
# Services ID + Sign in with Apple key (.p8). Redirect URI (Return URL):
#   https://movepilotai.com/api/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=MovePilotAi <noreply@movepilotai.com>
NEXT_PUBLIC_SUPPORT_EMAIL=support@movepilotai.com

# Twilio SMS (optional — use toll-free for A2P in US)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=

# Cron job protection (used by scripts/cron-reminders.sh, backup, etc.)
CRON_SECRET=

# Optional privacy-friendly analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=movepilotai.com

# Stripe billing (one-time Pro checkout per move)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Namecheap API (DNS automation — scripts/setup-resend-dns.mjs)
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_API_SANDBOX=false
RESEND_DOMAIN_ID=
RESEND_DKIM_VALUE=

# Admin seed script (npm run seed:admin)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@movepilot.local
ADMIN_PASSWORD=
